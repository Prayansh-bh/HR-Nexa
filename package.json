{
  "name": "hr-nexa",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "owner"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "dev:owner": "npm run dev --workspace=owner",
    "build:owner": "npm run build --workspace=owner",
    "dev:backend": "npm run dev --workspace=backend",
    "build:backend": "npm run build --workspace=backend",
    "start:backend": "npm run start:prod --workspace=backend"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.120.0",
    "@oxc-parser/binding-linux-x64-musl": "0.120.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.0",
    "@rolldown/binding-linux-x64-musl": "1.2.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}
