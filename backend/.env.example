# HR Nexa Backend Environment Variables Template
# Copy this file to .env and fill in your actual production/development credentials.

# Database Connection (PostgreSQL / Neon / AWS RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/hrms_db?schema=public"

# Authentication & Security
JWT_SECRET="your_secure_jwt_secret_key"
JWT_EXPIRATION="24h"
PORT=3001
NODE_ENV="development"
TENANT_APP_URL="http://localhost:5173"
OWNER_APP_URL="http://localhost:5174"
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5174,http://localhost:5173,http://localhost:3000,https://hrnexa.com,https://www.hrnexa.com,https://hr-nexa.vercel.app,https://app.hrnexa.com"

# AWS S3 Storage Provider Configuration
STORAGE_DRIVER="local" # "local" or "s3"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your_s3_bucket_name"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# Email SMTP Gateway Configuration
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_SECURE="false"
EMAIL_USER="your_smtp_username"
EMAIL_PASS="your_smtp_password"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_NAME="HR Nexa"

# Razorpay Payment Gateway Configuration (Production / Staging)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

