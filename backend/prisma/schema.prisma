model PaymentOrder {
  id                    String    @id @default(uuid())

  orderId               String    @unique
  paymentId             String?   @unique
  signature             String?

  provider              String    @default("RAZORPAY")

  status                String    @default("CREATED")

  planName              String
  planVersionId         String
  billingCycle          String

  amountMinor           Int
  currency              String    @default("INR")

  companyName           String
  ownerName             String
  ownerEmail            String
  contact               String?
  gst                   String?
  address               String?

  subscriptionId        String?
  companyId             String?

  failureReason         String?
  retryCount            Int       @default(0)

  provisioningStartedAt DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  paidAt                DateTime?
  provisionedAt         DateTime?
  expiresAt             DateTime

  @@index([status])
  @@index([ownerEmail])
  @@index([companyId])
}

enum DPRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
}

enum DPRTaskStatus {
  COMPLETED
  IN_PROGRESS
  BLOCKED
}

model DailyProgressReport {
  id             String               @id @default(uuid())
  companyId      String
  employeeId     String
  reportDate     String
  status         DPRStatus            @default(DRAFT)
  summary        String
  blockers       String?
  hoursWorked    Float                @default(0)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewerRemark String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee  @relation("EmployeeDPRs", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("ReviewerDPRs", fields: [reviewedById], references: [id], onDelete: SetNull)
  tasks    DPRTaskItem[]

  @@unique([companyId, employeeId, reportDate])
  @@index([companyId, reportDate])
  @@index([employeeId, reportDate])
  @@index([companyId, status])
}

model DPRTaskItem {
  id           String        @id @default(uuid())
  reportId     String
  title        String
  description  String?
  status       DPRTaskStatus @default(COMPLETED)
  minutesSpent Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  report DailyProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

