  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear       FiscalYear           @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items            ExpenseClaimItem[]

  @@unique([companyId, claimNumber])
  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@index([employeeId, fiscalYearId])
  @@index([companyId, paymentStatus])
}

model ExpenseClaimItem {
  id                String              @id @default(uuid())
  claimId           String
  categoryId        String

  amount            Float
  approvedAmount    Float               @default(0)

  expenseDate       DateTime
  merchant          String?
  description       String?

  taxTreatment      ExpenseTaxTreatment @default(NON_TAXABLE)

  receiptDocumentId String?
  remarks           String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  claim             ExpenseClaim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category          ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receiptDocument   Document?           @relation(fields: [receiptDocumentId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([categoryId])
  @@index([receiptDocumentId])
}

enum TaxRegime {
  OLD
  NEW
}

enum TaxDeclarationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
}

model TaxDeclaration {
  id              String               @id @default(uuid())
  companyId       String
  employeeId      String
  fiscalYearId    String
  regime          TaxRegime            @default(NEW)
  status          TaxDeclarationStatus @default(DRAFT)
  totalDeclared   Float                @default(0)
  totalApproved   Float                @default(0)
  remarks         String?
  reviewedById    String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear      FiscalYear           @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  items           TaxDeclarationItem[]

  @@unique([companyId, employeeId, fiscalYearId])
  @@index([companyId, status])
  @@index([employeeId, fiscalYearId])
  @@index([companyId, fiscalYearId])
}

model TaxDeclarationItem {
  id               String         @id @default(uuid())
  taxDeclarationId String
  section          String
  category         String
  declaredAmount   Float          @default(0)
  approvedAmount   Float          @default(0)
  proofDocumentId  String?
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  declaration      TaxDeclaration @relation(fields: [taxDeclarationId], references: [id], onDelete: Cascade)
  proofDocument    Document?      @relation(fields: [proofDocumentId], references: [id], onDelete: SetNull)

  @@index([taxDeclarationId])
}

