generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String               @id @default(uuid())
  email                       String               @unique
  password                    String
  name                        String
  role                        String               @default("Employee")
  roleId                      String?
  permissionVersion           Int                  @default(1)
  initials                    String
  status                      String               @default("Logged Out")
  notificationPrefs           String               @default("{\"leaveRequests\":true,\"payrollReady\":true,\"birthdayReminders\":true,\"weeklyDigest\":false,\"attendanceAlerts\":true,\"systemUpdates\":true}")
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  subscriptionId              String?
  companyId                   String?
  sessionVersion              Int                  @default(1)
  uploadedDocuments           Document[]           @relation("UploadedDocuments")
  verifiedDocuments           Document[]           @relation("DocumentVerifier")
  employee                    Employee?
  exitApprovals               ExitApproval[]
  completedExitChecklistItems ExitChecklistItem[]
  conductedExitInterviews     ExitInterview[]
  receivedMessages            Message[]            @relation("ReceivedMessages")
  sentMessages                Message[]            @relation("SentMessages")
  passwordResetTokens         PasswordResetToken[]
  company                     Company?             @relation(fields: [companyId], references: [id])
  roleRelation                Role?                @relation("UserToRole", fields: [roleId], references: [id])
  subscription                Subscription?        @relation(fields: [subscriptionId], references: [id])
  sessions                    UserSession[]

  @@index([companyId, role])
  @@index([subscriptionId, role])
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  familyId       String    @default(uuid())
  tokenHash      String    @unique
  sessionVersion Int       @default(1)
  ip             String?
  userAgent      String?
  browser        String?
  os             String?
  deviceType     String?   @default("Desktop")
  issuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @updatedAt
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  refreshCount   Int       @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId])
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

model OtpChallenge {
  id             String    @id @default(uuid())
  challengeToken String    @unique
  userId         String
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  status         String    @default("PENDING")
  verifiedAt     DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([challengeToken])
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  companyId   String?
  isSystem    Boolean  @default(false)
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]   @relation("UserToRole")

  @@unique([name, companyId])
}

model Employee {
  id                             String                   @id
  name                           String
  email                          String                   @unique
  departmentId                   String?
  designationId                  String?
  status                         String
  joined                         String
  salary                         Float
  avatar                         String
  phone                          String?
  address                        String?
  dob                            String?
  gender                         String?
  uan                            String?
  esic                           String?
  pan                            String?
  aadhaar                        String?
  bankName                       String?
  accountNumber                  String?
  ifscCode                       String?
  location                       String?
  maritalStatus                  String?
  bloodGroup                     String?
  passportNumber                 String?
  personalEmail                  String?
  permanentAddress               String?
  emergencyContactNamePrimary    String?
  emergencyContactRelPrimary     String?
  emergencyContactPhonePrimary   String?
  emergencyContactNameSecondary  String?
  emergencyContactRelSecondary   String?
  emergencyContactPhoneSecondary String?
  photoData                      String?
  photoRotation                  Int?                     @default(0)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  userId                         String?                  @unique
  subscriptionId                 String?
  companyId                      String?
  managerId                      String?
  deletedAt                      DateTime?
  deletedBy                      String?
  attendance                     Attendance[]
  companyAssets                  CompanyAsset[]
  assetHistories                 AssetHistory[]
  documents                      Document[]
  company                        Company?                 @relation(fields: [companyId], references: [id])
  department                     Department?              @relation(fields: [departmentId], references: [id])
  designation                    Designation?             @relation(fields: [designationId], references: [id])
  manager                        Employee?                @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates                   Employee[]               @relation("ManagerToEmployee")
  subscription                   Subscription?            @relation(fields: [subscriptionId], references: [id])
  user                           User?                    @relation(fields: [userId], references: [id])
  exits                          Exit[]
  leaveQuotas                    LeaveQuota[]
  leaveRequests                  LeaveRequest[]
  payrolls                       Payroll[]
  performanceGoals               PerformanceGoal[]
  performanceReviews             PerformanceReview[]      @relation("EmployeeReviews")
  managerReviews                 PerformanceReview[]      @relation("ManagerReviews")
  reviewParticipants             ReviewCycleParticipant[]
  taxDeclarations                TaxDeclaration[]
  expenseClaims                  ExpenseClaim[]
  payrollInputs                  PayrollInput[]
  regularizationRequests         AttendanceRegularizationRequest[] @relation("EmployeeAttendanceRequests")
  reviewedAttendanceRequests     AttendanceRegularizationRequest[] @relation("ReviewerAttendanceRequests")
  dailyProgressReports           DailyProgressReport[]             @relation("EmployeeDPRs")
  reviewedDPRs                  DailyProgressReport[]             @relation("ReviewerDPRs")

  @@index([companyId, status])
  @@index([subscriptionId, status])
  @@index([subscriptionId, departmentId])
}

model Department {
  id              String           @id @default(uuid())
  name            String
  head            String?
  subscriptionId  String?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  company         Company?         @relation(fields: [companyId], references: [id])
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id])
  designations    Designation[]    @relation("DepartmentDesignations")
  employees       Employee[]
  jobRequisitions JobRequisition[] @relation("RequisitionDepartment")

  @@unique([name, subscriptionId])
  @@index([subscriptionId])
}

model Designation {
  id              String           @id @default(uuid())
  name            String
  band            String
  departmentId    String?
  subscriptionId  String?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company?         @relation(fields: [companyId], references: [id])
  department      Department?      @relation("DepartmentDesignations", fields: [departmentId], references: [id])
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id])
  employees       Employee[]
  jobRequisitions JobRequisition[] @relation("RequisitionDesignation")

  @@unique([name, subscriptionId])
  @@index([subscriptionId])
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       String
  inTime     String?
  outTime    String?
  status     String
  remarks    String?
  ipAddress  String?
  deviceId   String?
  latitude   String?
  longitude  String?
  verified   Boolean  @default(false)
  source     AttendanceSource @default(UNKNOWN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  regularizationRequests AttendanceRegularizationRequest[]

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id         String             @id @default(uuid())
  employeeId String
  type       String
  from       String
  to         String
  days       Float
  reason     String
  status     LeaveRequestStatus @default(PENDING)
  department String?
  companyId  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, from, to])
  @@index([companyId, status])
  @@index([employeeId, status])
}

model LeaveQuota {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String
  totalDays  Float
  usedDays   Float    @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType])
}

model Payroll {
  id                 String        @id @default(uuid())
  employeeId         String
  month              String
  payDate            String?
  fixedBaseSalary    Float         @default(0)
  basicSalary        Float
  allowances         Float
  gross              Float         @default(0)
  deductions         Float
  netSalary          Float
  lopDays            Float         @default(0)
  lopDeductAmount    Float         @default(0)
  lopDivisorMode     String        @default("CALENDAR_DAYS")
  lopDivisor         Float         @default(0)
  status             PayrollStatus @default(DRAFT)
  warnings           String?
  payslipPath        String?
  components         Json?
  adjustments        Json?
  calculationVersion Int           @default(1)
  version            Int           @default(1)
  companyId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@index([companyId, month])
  @@index([month, status])
}

model PayrollInput {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  month         String
  lopDays       Float    @default(0)
  overtimeHours Float    @default(0)
  bonus         Float    @default(0)
  deductions    Float    @default(0)
  remarks       String?
  createdBy     String
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@index([companyId, month])
  @@index([employeeId])
}

model Document {
  id              String           @id @default(uuid())
  companyId       String?
  employeeId      String?
  title           String?
  category        DocumentCategory @default(EMPLOYEE)
  docType         String
  fileName        String
  size            String
  fileData        String?
  filePath        String?
  status          DocumentStatus   @default(VALID)
  expiryDate      DateTime?

  verificationStatus DocumentVerificationStatus @default(PENDING)
  verificationNote   String?
  verifiedById       String?
  verifiedAt         DateTime?
  verifiedBy         User?                      @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  uploadedById    String?
  uploaded        String?
  uploadedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  migratedAt      DateTime?
  storageProvider String           @default("LOCAL")
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy      User?            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  taxDeclarationItems TaxDeclarationItem[]
  expenseClaimItems   ExpenseClaimItem[]
  offer           Offer?

  @@index([companyId, employeeId])
  @@index([companyId, category])
  @@index([employeeId, category])
  @@index([storageProvider])
  @@index([companyId, verificationStatus])
}

model Announcement {
  id             String        @id @default(uuid())
  title          String
  content        String
  type           String?       @default("Notice")
  scheduledFor   DateTime?
  duration       String?
  date           String
  author         String
  readCount      Int           @default(0)
  subscriptionId String?
  createdAt      DateTime      @default(now())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model AuditLog {
  id          String          @id @default(uuid())
  actorId     String
  actorRole   String
  companyId   String
  action      String
  entityType  AuditEntityType
  entityId    String?
  beforeState Json?
  afterState  Json?
  metadata    Json?
  userId      String?
  userName    String?
  details     String?
  timestamp   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
}

model Message {
  id                String   @id @default(uuid())
  senderId          String
  receiverId        String
  companyId         String
  subject           String
  body              String
  timestamp         String
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
  deletedBySender   Boolean  @default(false)
  deletedByReceiver Boolean  @default(false)
  company           Company  @relation(fields: [companyId], references: [id])
  receiver          User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender            User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([companyId])
  @@index([senderId])
  @@index([receiverId])
  @@index([companyId, receiverId])
  @@index([companyId, senderId])
  @@index([createdAt])
}

model JobRequisition {
  id                  String        @id @default(uuid())
  title               String
  department          String
  departmentId        String?
  designationId       String?
  hiringManager       String?
  location            String        @default("Remote")
  type                String        @default("Full-Time")
  priority            String        @default("Medium")
  openings            Int           @default(1)
  applicantsCount     Int           @default(0)
  minSalary           Float?
  maxSalary           Float?
  currency            String        @default("INR")
  budgetJustification String?
  jobDescription      String?
  skillsRequired      String?
  experienceRequired  String?
  educationRequired   String?
  expectedJoiningDate String?
  status              String        @default("Open")
  subscriptionId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  departmentRel       Department?   @relation("RequisitionDepartment", fields: [departmentId], references: [id])
  designationRel      Designation?  @relation("RequisitionDesignation", fields: [designationId], references: [id])
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([subscriptionId, status])
}

model Candidate {
  id             String               @id @default(uuid())
  name           String
  email          String
  jobId          String
  jobTitle       String
  stage          String               @default("Applied")
  experience     String               @default("3 Yrs")
  appliedDate    String
  resume         String?
  score          Float?
  subscriptionId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  subscription   Subscription?        @relation(fields: [subscriptionId], references: [id])
  evaluations    CandidateEvaluation?
  offer          Offer?

  @@index([subscriptionId])
  @@index([jobId])
  @@index([subscriptionId, stage])
}

model CandidateEvaluation {
  id                    String    @id @default(uuid())
  candidateId           String    @unique
  evaluatorId           String?
  technicalSkills       Float
  communication         Float
  experienceMatch       Float
  culturalFit           Float
  problemSolving        Float
  leadership            Float
  calculatedScore       Float
  overallRecommendation String    @default("Yes")
  notes                 String?
  subscriptionId        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Offer {
  id                   String        @id @default(uuid())
  candidateId          String        @unique
  jobPostingId         String?
  companyId            String?
  subscriptionId       String?
  annualCTC            Float
  monthlyCTC           Float
  annualGross          Float
  monthlyGross         Float
  designation          String
  joiningDate          String
  expiryDate           String?
  status               String        @default("DRAFT")
  compensationSnapshot Json
  documentId           String?       @unique
  generatedAt          DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  candidate            Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id])
  document             Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
}

model Subscription {
  id              String              @id @default(uuid())
  company         String
  plan            String
  cycle           String
  start           String
  expiry          String
  amount          Float
  status          String
  gst             String?
  pan             String?
  cin             String?
  address         String?
  contact         String?
  hrAdmin         String?
  ownerName       String?
  ownerEmail      String?
  billing         String?
  storageUsed     String?
  storageUsedMB   Int?                @default(0)
  storageLimitMB  Int?                @default(10240)
  employeesCount  Int?                @default(1)
  purchasedSeats  Int?                @default(50)
  usedSeats       Int?                @default(1)
  logo            String?
  autoRenew       Boolean             @default(true)
  currency        String              @default("INR")
  suspendedAt     String?
  cancelledAt     String?
  suspendReason   String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  companyId       String?
  announcements   Announcement[]
  candidates      Candidate[]
  departments     Department[]
  designations    Designation[]
  employees       Employee[]
  jobs            JobRequisition[]
  companyRelation Company?            @relation(fields: [companyId], references: [id])
  events          SubscriptionEvent[]
  invoices        Invoice[]
  users           User[]
  offers          Offer[]

  @@index([companyId])
  @@index([status])
  @@index([company])
}

model Invoice {
  id             String        @id
  type           String
  company        String
  date           String
  amount         Float
  status         String
  subscriptionId String?
  couponCode     String?
  tax            Float?        @default(0)
  discount       Float?        @default(0)
  period         String?
  planName       String?
  planVersion    Int?
  seatCount      Int?
  storageGB      Float?
  unitPrice      Decimal?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([company])
  @@index([subscriptionId])
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  event          String
  fromPlan       String?
  toPlan         String?
  fromStatus     String?
  toStatus       String?
  performedBy    String?
  note           String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String?
  discountType  String
  discountValue Float
  maxUses       Int      @default(1)
  usedCount     Int      @default(0)
  validFrom     String
  validUntil    String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentRecord {
  id               String          @id @default(uuid())
  invoiceId        String?
  company          String
  amount           Float
  refundedAmount   Float           @default(0)
  paymentMethod    String
  transactionId    String
  gatewayPaymentId String?
  status           String
  type             String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  refunds          PaymentRefund[]

  @@index([company])
  @@index([invoiceId])
  @@index([gatewayPaymentId])
}

model PaymentRefund {
  id               String        @id @default(uuid())
  paymentRecordId  String
  paymentRecord    PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  gateway          String        @default("RAZORPAY")
  gatewayPaymentId String
  gatewayRefundId  String?       @unique
  amount           Float
  amountMinor      Int
  currency         String        @default("INR")
  status           String        @default("REQUESTED")
  reason           String?
  receipt          String?
  requestedBy      String?
  requestedAt      DateTime      @default(now())
  processedAt      DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([paymentRecordId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model SaaSPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  price     String
  features  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id          String    @id
  companyId   String?
  company     String    @default("Tenant Company")
  subject     String    @default("Support Request")
  priority    String    @default("Medium")
  assignedTo  String    @default("Support Team")
  status      String    @default("Open")
  attachments Int       @default(0)
  date        String
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companyRelation Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([company])
  @@index([company, status])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  sender    String
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model SystemConfig {
  key   String @id
  value String
}

model BiometricDevice {
  id        String   @id @default(uuid())
  name      String
  ip        String
  status    String   @default("Online")
  last      String   @default("Just now")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeoZone {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  latitude     Float?
  longitude    Float?
  radiusMeters Float
  address      String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([name, companyId])
  @@index([companyId])
}

model AttendanceSetting {
  id                   String   @id @default(uuid())
  companyId            String?  @unique
  gracePeriod          Int      @default(15)
  halfDayThreshold     Int      @default(240)
  otMultiplier         Float    @default(1.5)
  enableRegularization Boolean  @default(true)
  selfRegularization   Boolean  @default(false)
  shiftName            String   @default("General")
  shiftStart           String   @default("09:00")
  shiftEnd             String   @default("18:00")
  weekOffs             String   @default("Saturday,Sunday")
  enableGeofencing     Boolean  @default(false)
  geofenceOnClockOut   Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum AttendanceRegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceSource {
  ONLINE
  MOBILE
  BIOMETRIC
  MANUAL
  IMPORT
  API
  UNKNOWN
}

model AttendanceRegularizationRequest {
  id               String                         @id @default(uuid())
  attendanceId     String
  employeeId       String
  companyId        String?
  originalInTime   String?
  originalOutTime  String?
  requestedInTime  String
  requestedOutTime String
  reason           String
  status           AttendanceRegularizationStatus @default(PENDING)
  reviewerId       String?
  reviewerRemark   String?
  submittedAt      DateTime                       @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee   Employee   @relation("EmployeeAttendanceRequests", fields: [employeeId], references: [id], onDelete: Cascade)
